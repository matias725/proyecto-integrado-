# =====================================================================
# SGR La Serena · configuración de ejemplo
# Copie este archivo como .env y complete los valores. El archivo .env
# real NUNCA se sube al repositorio (está en .gitignore).
# =====================================================================

# --- General ---------------------------------------------------------
SGR_DEBUG=0                      # 1 solo en desarrollo local
SGR_SECRET_KEY=                  # genere una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SGR_HOSTS=localhost,127.0.0.1    # en AWS: la IP pública o el dominio, separados por coma
SGR_CSRF_ORIGENES=               # en AWS: http://IP-PUBLICA o https://dominio
SGR_HTTPS=0                      # 1 cuando el sitio se publique con HTTPS
SGR_CUENTAS_DEMO=1               # 1 muestra las cuentas de evaluación en el acceso

# --- Base de datos ---------------------------------------------------
# sqlite para desarrollo; mysql para AWS (RDS o MySQL en la instancia)
SGR_DB_MOTOR=sqlite
SGR_DB_NOMBRE=db.sqlite3         # con mysql: sgr_laserena
SGR_DB_USUARIO=
SGR_DB_CLAVE=
SGR_DB_HOST=127.0.0.1
SGR_DB_PUERTO=3306

# --- Correo (recuperación de contraseña) -----------------------------
# Por defecto los correos quedan en la «Bandeja de correos de prueba»
# (menú Control, solo Superadministrador). Para enviar correos reales:
# SGR_CORREO_BACKEND=django.core.mail.backends.smtp.EmailBackend
SGR_CORREO_BACKEND=cuentas.correo.BandejaBackend
SGR_SMTP_HOST=
SGR_SMTP_PUERTO=587
SGR_SMTP_USUARIO=
SGR_SMTP_CLAVE=
SGR_SMTP_TLS=1
SGR_CORREO_REMITENTE=SGR La Serena <no-responder@example.test>

# --- Reglas de seguridad (valores del enunciado) ---------------------
SGR_CODIGO_VIGENCIA_MIN=10
SGR_CODIGO_REENVIO_SEG=45
SGR_CODIGO_MAX_INTENTOS=5
SGR_CODIGO_MAX_POR_HORA=5
SGR_LOGIN_MAX_INTENTOS=5
SGR_LOGIN_BLOQUEO_MIN=10

# --- Matriz SGR (EV2) -------------------------------------------------
# SGR_ARCHIVOS_DIR=archivos        # evidencias y respaldos; en AWS: /opt/sgr/archivos (fuera del código)
SGR_EVIDENCIA_MAX_MB=2           # tamaño máximo por archivo (Nginx acepta hasta 10 MB)
# SGR_CACHE_DIR=cache              # caché compartida entre procesos (límite por IP); en AWS: /opt/sgr/cache
SGR_FECHA_HOY=                   # solo para demostraciones: fija la fecha del sistema (AAAA-MM-DD)

# --- Límite de intentos por dirección IP (acceso y recuperación) -----
SGR_IP_MAX_INTENTOS=20
SGR_IP_VENTANA_MIN=15
SGR_DETRAS_DE_PROXY=0            # 1 solo detrás de Nginx (AWS): toma la IP real de X-Forwarded-For
