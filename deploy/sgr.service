# /etc/systemd/system/sgr.service
# Servicio de la aplicación (Gunicorn). Lee los secretos desde /opt/sgr/.env
[Unit]
Description=SGR La Serena (Django + Gunicorn)
After=network.target mysql.service

[Service]
User=sgr
Group=www-data
WorkingDirectory=/opt/sgr/app
EnvironmentFile=/opt/sgr/.env
ExecStart=/opt/sgr/venv/bin/gunicorn sgr.wsgi -c gunicorn.conf.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
